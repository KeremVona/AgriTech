# ==========================================
# Precision AgriTech Platform - .gitignore
# ==========================================

# ------------------------------------------
# Environment & Secrets (NEVER COMMIT)
# ------------------------------------------
.env
.env.*
!.env.example
secrets.json
appsettings.Local.json
*.pem
*.key
*.cert

# ------------------------------------------
# .NET / C# / ASP.NET Core
# ------------------------------------------
bin/
obj/
[Dd]ebug/
[Rr]elease/
x64/
x86/
[Bb]uild/
*.user
*.suo
*.userosscache
*.sln.docstates
.vs/
_ReSharper*/
*.dotCover

# ------------------------------------------
# Node.js / React / TypeScript
# ------------------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
dist/
out/
build/
.next/
.turbo/
*.tsbuildinfo
.eslintcache

# ------------------------------------------
# Python / Machine Learning / PyTorch
# ------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# Virtual Environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# ML Datasets & Large Binary Weights
# (Store datasets and model checkpoints locally or on cloud storage / DVC)
datasets/
data/raw/
data/processed/
*.pt
*.pth
*.ckpt
*.h5
# Keep small demo onnx weights or mock fixtures if needed, but exclude large runs
*.onnx.bak

# ------------------------------------------
# Databases & Docker Volumes
# ------------------------------------------
*.db
*.sqlite
*.sqlite3
pgdata/
docker-data/

# ------------------------------------------
# Operating System & IDE Files
# ------------------------------------------
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# JetBrains
.idea/
*.iml
*.iws

# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace
