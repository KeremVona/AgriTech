# ==========================================
# Precision AgriTech Platform - Environment Variables Template
# Copy this file to .env or service-specific configuration before running
# ==========================================

# ------------------------------------------
# Database (PostgreSQL + PostGIS)
# ------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=agritech_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_CONNECTION_STRING="Host=localhost;Port=5432;Database=agritech_db;Username=postgres;Password=postgres"

# ------------------------------------------
# Backend API (ASP.NET Core)
# ------------------------------------------
ASPNETCORE_ENVIRONMENT=Development
BACKEND_PORT=5000

# ------------------------------------------
# ML & Vision Service (FastAPI)
# ------------------------------------------
ML_SERVICE_PORT=8000
ML_SERVICE_URL=http://localhost:8000

# ------------------------------------------
# Frontend Client (Vite + React)
# ------------------------------------------
VITE_API_BASE_URL=http://localhost:5000
VITE_ML_SERVICE_URL=http://localhost:8000
