# ==========================================
# Precision AgriTech Platform - Environment Variables Template
# Copy this file to .env or service-specific configuration before running
# ==========================================

# ------------------------------------------
# Database (PostgreSQL + PostGIS)
# ------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=agritech_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_CONNECTION_STRING="Host=localhost;Port=5432;Database=agritech_db;Username=postgres;Password=postgres"

# ------------------------------------------
# Backend API (ASP.NET Core)
# ------------------------------------------
ASPNETCORE_ENVIRONMENT=Development
BACKEND_PORT=5000

# ------------------------------------------
# ML & Vision Service (FastAPI)
# ------------------------------------------
ML_SERVICE_PORT=8000
ML_SERVICE_URL=http://localhost:8000

# ML Service Docker-specific settings (TODO-106)
ONNX_MODEL_PATH=models/agritech_classifier.onnx
ML_DEBUG=false
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]


# ------------------------------------------
# Frontend Client (Vite + React)
# ------------------------------------------
VITE_API_BASE_URL=http://localhost:5000
VITE_ML_SERVICE_URL=http://localhost:8000

# ------------------------------------------
# Eclipse Mosquitto MQTT Broker (BACK-304)
# Note: MQTT_* variables configure the Mosquitto Docker container entrypoint & ACL.
# For ASP.NET Core backend overrides, use double-underscore keys:
#   Mqtt__Host, Mqtt__Port, Mqtt__Username, Mqtt__Password
# ------------------------------------------
MQTT_HOST=127.0.0.1
MQTT_PORT=1883
MQTT_BACKEND_USER=agritech_backend
MQTT_BACKEND_PASSWORD=agritech_backend_dev_pwd
MQTT_SIMULATOR_USER=agritech_simulator
MQTT_SIMULATOR_PASSWORD=agritech_simulator_dev_pwd
