# ==============================================================================
# AgriTech Frontend Client - Environment Configuration Template
# ==============================================================================
#
# IMPORTANT: Vite runs from the `frontend/` directory and reads environment
# files located directly in `frontend/` (e.g. `frontend/.env.local`), NOT the
# repository root `.env`. Copy this template:
#
#   cp frontend/.env.example frontend/.env.local
#
# ==============================================================================

# ------------------------------------------------------------------------------
# GIS Field Map Configuration (TODO-207)
# ------------------------------------------------------------------------------

# Base URL for spatial GIS endpoints.
# Defaults to VITE_API_BASE_URL if set, or http://localhost:5051 (the actual ASP.NET
# Core backend launch port defined in backend/Properties/launchSettings.json).
# Note: The repository root .env.example advertises port 5000, but the development
# Kestrel server boots on port 5051.
# Must be an absolute HTTP or HTTPS URL (no path query or hash).
VITE_GIS_API_BASE_URL=http://localhost:5051

# Path to the parcel GeoJSON FeatureCollection endpoint.
# Defaults to /api/v1/spatial/geojson/parcels (implemented in TODO-204).
#
# FUTURE INTEGRATION NOTE: When TODO-205 (field-scoped parcel CRUD) is ready,
# this is the single configuration path to update (e.g. to /api/v1/fields/<id>/parcels),
# requiring zero component or hook code changes.
# Must start with a single '/' (e.g. /api/v1/spatial/geojson/parcels).
VITE_GIS_PARCELS_PATH=/api/v1/spatial/geojson/parcels

# Data loading mode for the GIS Field Map.
# Options:
#   auto   - (Default) Fetches live data from the backend. If the backend is unavailable
#            (HTTP 5xx, HTTP 404, network failure, or 5000ms timeout), automatically
#            falls back to bundled demonstration parcels with an explicit notice
#            ("Sample data — live data unavailable") and a retry action.
#            The fallback applies to loading only; writes against sample data stay local.
#            Hard errors (HTTP 401/403, 429, malformed contracts) remain errors.
#   api    - Strict live API mode. Never substitutes sample data. Any network or
#            server failure surfaces as an explicit error banner with retry.
#   sample - Demonstration mode. Makes no network requests to the backend API;
#            immediately loads bundled fictional demonstration parcels located in
#            rural Türkiye.
VITE_GIS_DATA_MODE=auto

# ------------------------------------------------------------------------------
# Feed Limits & Remote Tile Dependencies
# ------------------------------------------------------------------------------
#
# 1. 100-Record Feed Limit:
#    The TODO-204 backend endpoint (/api/v1/spatial/geojson/parcels) currently limits
#    results to 100 parcel features. The frontend Field Map header reports the exact
#    number of loaded parcels rather than claiming full farm coverage.
#
# 2. Remote Tile Imagery Dependency:
#    The map requires external internet access to load raster basemap tiles:
#      - Satellite: Esri World Imagery (ArcGIS MapServer)
#      - Streets:   OpenStreetMap (Standard Carto style)
#    Running in `sample` data mode or offline fallback provides parcel vector
#    geometries locally, but raster map tiles still require an active network
#    connection to tile providers.
#
# ------------------------------------------------------------------------------
# General Platform API Endpoints (Pre-existing)
# ------------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:5051
VITE_ML_SERVICE_URL=http://localhost:8000
