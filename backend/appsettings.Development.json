{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=agritech_db;Username=postgres;Password=postgres"
  },
  "OpenMeteo": {
    "BaseUrl": "https://api.open-meteo.com",
    "TimeoutSeconds": 15,
    "MaxRetryAttempts": 3,
    "InitialBackoffSeconds": 1.0
  },
  "WeatherIngestion": {
    "Enabled": true,
    "IntervalHours": 24,
    "InitialDelaySeconds": 10,
    "RunAtStartup": false
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}