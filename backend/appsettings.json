{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=agritech_db;Username=postgres;Password=postgres"
  },
  "OpenMeteo": {
    "BaseUrl": "https://api.open-meteo.com",
    "TimeoutSeconds": 15,
    "MaxRetryAttempts": 3,
    "InitialBackoffSeconds": 1.0
  },
  "WeatherIngestion": {
    "Enabled": true,
    "IntervalHours": 24,
    "InitialDelaySeconds": 10,
    "RunAtStartup": false
  },
  "CropPhenology": {
    "ConfigFilePath": "Configuration/crop_growth_stages.json"
  },
  "Mqtt": {
    "Enabled": true,
    "Host": "127.0.0.1",
    "Port": 1883,
    "ClientId": "agritech-backend-api",
    "Username": "agritech_backend",
    "Password": "",
    "UseTls": false,
    "CleanSession": false,
    "SessionExpiryIntervalSeconds": 86400,
    "KeepAliveSeconds": 30,
    "ConnectTimeoutSeconds": 10,
    "ReconnectInitialDelaySeconds": 2,
    "ReconnectMaxDelaySeconds": 60,
    "TelemetryWildcardTopic": "agri/telemetry/#"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Gemini": {
    "ApiKey": "",
    "Model": "gemini-2.5-flash",
    "BaseUrl": "https://generativelanguage.googleapis.com/v1beta"
  }
}